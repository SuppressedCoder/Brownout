{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "paths": {
      "@core/*": [
        "./src/core/*"
      ]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "scripts/**/*",
    "electron.vite.config.mts",
    "vite.web.config.mts",
    "tests/**/*"
  ]
}